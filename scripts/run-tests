#!/bin/sh

mode=$1
files=$(cat)
tested="$(git rev-parse --git-dir)/joid-tested"

changed() {
    printf '%s\n' "$files" | grep -qE "$1"
}

jars=0
if changed '^(core/|base/|backend/|tool/|gradle/|build\.gradle$|settings\.gradle$|gradle\.properties$|gradlew|NOTICE$|licenses/)'; then
    jars=1
fi

template=0
if changed '^(core/|template/|tool/testkit/|gradle/snapshots\.gradle$|gradle/variants\.gradle$|build\.gradle$)'; then
    template=1
fi

render=0
if changed '^(core/src/main/|base/|backend/|tool/(msdf|testkit)/src/main/|gradle/|build\.gradle$)'; then
    render=1
fi

showcase=0
if changed '^sample/showcase/(src/|build\.gradle$)'; then
    showcase=1
fi

if [ $jars -eq 0 ] && [ $template -eq 0 ] && [ $showcase -eq 0 ]; then
    echo "[JOID] 🔍 No source change, tests skipped"
    echo ""
    if [ "$mode" = "index" ] && grep -qx "$(git rev-parse HEAD^{tree})" "$tested" 2>/dev/null; then
        { tail -n 99 "$tested"; git write-tree; } > "$tested.tmp" && mv "$tested.tmp" "$tested"
    fi
    exit 0
fi

stashed=0
restore() {
    if [ $stashed -eq 1 ]; then
        echo ""
        echo "[JOID] 🧹 Restoring the changes left out of the test"
        git reset -q --hard
        git stash pop -q --index || echo "[JOID] ⚠️  Unable to restore them, run: git stash pop --index"
    fi
}

before=$(git rev-parse -q --verify refs/stash)
if [ "$mode" = "index" ]; then
    git stash push -q --keep-index --include-untracked -m "joid-tests"
else
    tree=$(git rev-parse HEAD^{tree})
    git stash push -q --include-untracked -m "joid-tests"
fi

if [ "$(git rev-parse -q --verify refs/stash)" != "$before" ]; then
    stashed=1
fi
trap restore EXIT

all=0
if changed '^(core/|tool/|gradle/|build\.gradle$|settings\.gradle$|gradle\.properties$|gradlew)'; then
    all=1
fi

tasks=""
if [ $all -eq 1 ]; then
    tasks=":tool-msdf:check :core:check :tool-testkit:check"
fi

for module in glfw openal opengl; do
    if [ $all -eq 1 ] || changed "^base/$module/"; then
        tasks="$tasks :base-$module:check"
    fi
done

if [ "$mode" = "index" ]; then
    for module in lwjgl2 lwjgl3 vulkan; do
        if changed "^(base/|backend/$module/)"; then
            tasks="$tasks :backend-$module:check"
        fi
    done

    echo "[JOID] 🔍 pre-commit: compile & unit tests"
    echo ""
    ./gradlew compileJava compileTestJava jarCheckClasses $tasks -PskipSnapshots --offline
    status=$?
else
    if [ $template -eq 1 ]; then
        tasks="$tasks checkTemplate"
    fi

    if [ $jars -eq 1 ]; then
        tasks="$tasks checkJars testProdJar testDevJar testDemoJar"
    fi

    if [ $render -eq 1 ]; then
        tasks="$tasks crossBackendTest"
    fi

    echo "[JOID] 🔍 pre-push: full suite"
    echo ""
    ./gradlew compileJava compileTestJava jarCheckClasses $tasks --offline
    status=$?
fi

echo ""
if [ $status -ne 0 ]; then
    echo "[JOID] ❌ Tests failed"
    if [ "$mode" != "index" ] && [ $render -eq 1 ]; then
        echo "[JOID]    Open build/snapshots/backend-<name>/report.html or build/snapshots/cross/report.html to inspect the differences"
        echo "[JOID]    Run ./gradlew updateSnapshots if the visual change is intended"
    fi
elif [ "$mode" = "index" ]; then
    echo "[JOID] ✅ Done with the unit tests, the pre-push hook runs the full suite"
else
    echo "[JOID] ✅ Done with tests"
    { tail -n 99 "$tested" 2>/dev/null; echo "$tree"; } > "$tested.tmp" && mv "$tested.tmp" "$tested"
fi
echo ""

exit $status
