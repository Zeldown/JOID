#!/bin/sh

if ! git diff --cached --name-only | grep -qE '^(core/|impl/|gradle/|build\.gradle|settings\.gradle)'; then
    exit 0
fi

echo ""
echo "🚀 Running pre-commit hook"
echo ""
echo ""

echo "🔍 Running unit, snapshot and cross-backend tests"
./gradlew check crossBackendTest --offline
status=$?
if [ $status -ne 0 ]; then
    echo ""
    echo ""
    echo "❌ Commit rejected due to failing tests"
    echo "   Rendered snapshots and differences are in build/snapshots"
    echo "   Run ./gradlew updateSnapshots if the visual change is intended"
    echo ""
    echo ""
    exit $status
fi

echo ""
echo ""
echo "✅ Done with tests"
echo ""
echo ""

exit $status
