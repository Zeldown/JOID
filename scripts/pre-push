#!/bin/sh

echo ""
echo "🚀 Running pre-push hook on the pushed commits"
echo ""

zero=0000000000000000000000000000000000000000
files=""
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi

    if [ "$remote_sha" = "$zero" ]; then
        changed=$(git ls-files)
    else
        changed=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null) || changed=$(git ls-files)
    fi

    files="$files
$changed"
done

printf '%s\n' "$files" | sh scripts/run-tests head