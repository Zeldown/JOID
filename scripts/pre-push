#!/bin/sh

echo ""
echo "🚀 Running pre-push hook on the pushed commits"
echo ""

zero=0000000000000000000000000000000000000000
tested="$(git rev-parse --git-dir)/joid-tested"
files=""
untested=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi

    if ! grep -qx "$(git rev-parse "$local_sha^{tree}")" "$tested" 2>/dev/null; then
        if [ "$(git rev-parse "$local_sha^{commit}")" != "$(git rev-parse HEAD)" ]; then
            echo "❌ $local_ref is not the checked out commit and was never tested, check it out and push again"
            echo ""
            exit 1
        fi
        untested=1
    fi

    if [ "$remote_sha" = "$zero" ]; then
        changed=$(git ls-files)
    else
        changed=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null) || changed=$(git ls-files)
    fi

    files="$files
$changed"
done

if [ $untested -eq 0 ]; then
    echo "🔍 The tip of every pushed ref already passed the full suite, tests skipped"
    echo ""
    exit 0
fi

printf '%s\n' "$files" | sh scripts/run-tests head